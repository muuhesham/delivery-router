<html xmlns="http://www.w3.org/1999/xhtml" xmlns:hta="urn:schemas-microsoft-com:hta">
<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <title>Delivery Route Planner</title>
  <hta:application
    applicationname="Delivery Route Planner"
    border="thin"
    caption="yes"
    singleinstance="no"
    windowstate="maximize"
    width="980"
    height="720" />
  <style>
    html, body {
      width: 100%;
      height: 100%;
      margin: 0;
      overflow: hidden;
    }
    iframe {
      width: 100%;
      height: 100%;
      margin: 0;
      border: 0;
      display: block;
    }
  </style>
</head>
<body>
  <iframe src="http://localhost:3000/"></iframe>
</body>
</html>
